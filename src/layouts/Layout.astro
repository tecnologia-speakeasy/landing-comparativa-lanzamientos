---
import '../styles/global.css';

interface Props {
  titulo: string;
  descripcion?: string;
}

const {
  titulo,
  descripcion = 'Comparativa de registros e inversión de los lanzamientos de Speak Easy.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={descripcion} />
    <!-- Métricas internas: que no aparezcan en buscadores. -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#41276b" />
    <link rel="icon" type="image/png" sizes="32x32" href="/FAVICON.png" />
    <title>{titulo}</title>
  </head>
  <body class="min-h-dvh font-sans antialiased">
    <slot />
  </body>
</html>
