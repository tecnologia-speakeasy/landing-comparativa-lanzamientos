---
import Layout from '../layouts/Layout.astro';
import { cargarComparativa } from '../lib/lanzamientos';
import { fmtFechaLarga } from '../lib/formato';
import type { DatosComparativa } from '../lib/tipos';

let datos: DatosComparativa | null = null;
try {
  datos = await cargarComparativa();
  // La página se actualiza sola cada 10 s desde /api/comparativa.json; la
  // primera carga tampoco debe llegar más vieja que eso.
  Astro.response.headers.set('Cache-Control', 'public, s-maxage=10, stale-while-revalidate=10');
} catch (error) {
  console.error('[comparativa] no se pudieron leer los lanzamientos:', error);
  Astro.response.status = 503;
}

// `<` escapado para que ningún nombre pueda cerrar la etiqueta script de datos.
const json = datos ? JSON.stringify(datos).replace(/</g, '\\u003c') : '';
const hayDatos = !!datos?.lanzamientos.some(
  (l) =>
    l.registros.length > 0 ||
    l.inversion.puntos.length > 0 ||
    l.ventas.puntos.length > 0 ||
    l.downsell.puntos.length > 0,
);
---

<Layout titulo="Comparativa de lanzamientos · Speak Easy">
  <header class="bg-morado text-white">
    <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-5 gap-y-3 px-4 py-5 sm:px-6">
      <img src="/img/logo-speakeasy.webp" alt="Speak Easy" width="393" height="201" class="h-10 w-auto" />
      <div class="min-w-0 flex-1">
        <h1 class="text-xl font-bold sm:text-2xl">Comparativa de lanzamientos</h1>
        <p class="text-sm text-white/80">
          Lanzamiento actual frente al pasado: registros, inversión, fuentes y ventas.
        </p>
      </div>
      {
        datos && (
          <div class="w-full space-y-1 text-xs text-white/80 sm:w-auto sm:text-right">
            <p>
              Hoy: <span class="font-semibold text-white">{fmtFechaLarga(datos.hoy)}</span>
            </p>
            <p class="inline-flex items-center gap-1.5" aria-live="off">
              <span class="vivo size-2 rounded-full bg-[#4ade80]" aria-hidden="true" />
              <span id="estado-vivo">En vivo</span>
            </p>
          </div>
        )
      }
    </div>
  </header>

  <main class="mx-auto max-w-7xl space-y-5 px-4 py-6 sm:px-6">
    {
      !datos && (
        <div class="panel text-center">
          <p class="font-semibold">No se pudo leer la base de datos.</p>
          <p class="mt-1 text-sm text-tenue">Revisa la variable DATABASE_URL y vuelve a cargar la página.</p>
        </div>
      )
    }
    {
      datos && !hayDatos && (
        <div class="panel text-center">
          <p class="font-semibold">Aún no hay métricas registradas.</p>
          <p class="mt-1 text-sm text-tenue">
            Cuando un lanzamiento tenga registros o inversión en inventario, aparecerá aquí.
          </p>
        </div>
      )
    }

    {
      datos && hayDatos && (
        <>
          {/* Qué color es cada lanzamiento */}
          <section class="panel flex flex-wrap items-center gap-x-10 gap-y-4" aria-label="Lanzamientos comparados">
            <div id="leyenda" class="flex flex-wrap gap-x-10 gap-y-4" />
            <p class="text-xs text-tenue sm:ml-auto">El día 0 es la Clase 1. D-6 = seis días antes.</p>
          </section>

          {/* Gráficas */}
          <section class="grid grid-cols-1 gap-4 lg:grid-cols-2" aria-label="Gráficas">
            <article class="panel min-w-0" aria-labelledby="t-g-registros">
              <header>
                <h2 id="t-g-registros" class="text-sm font-bold">Registros</h2>
                <p class="text-xs text-tenue">Total acumulado de todas las fuentes, día a día.</p>
              </header>
              <div class="relative mt-3 h-72">
                <canvas id="g-registros" role="img" aria-label="Registros acumulados alineados a la Clase 1" />
              </div>
            </article>

            <article class="panel min-w-0" aria-labelledby="t-g-inversion">
              <header>
                <h2 id="t-g-inversion" class="text-sm font-bold">Inversión</h2>
                <p class="text-xs text-tenue" data-sub="inversion">Inversión acumulada en pauta, día a día.</p>
              </header>
              <div class="relative mt-3 h-72">
                <canvas id="g-inversion" role="img" aria-label="Inversión acumulada alineada a la Clase 1" />
              </div>
            </article>

            <article class="panel min-w-0 lg:col-span-2" aria-labelledby="t-g-fuentes">
              <header>
                <h2 id="t-g-fuentes" class="text-sm font-bold">Registros por fuente</h2>
                <p class="text-xs text-tenue" data-sub="fuentes" />
              </header>
              <div class="relative mt-3 h-80">
                <canvas id="g-fuentes" role="img" aria-label="Registros acumulados por fuente" />
              </div>
            </article>

            <article id="panel-ventas" class="panel min-w-0 lg:col-span-2" aria-labelledby="t-g-ventas">
              <header>
                <h2 id="t-g-ventas" class="text-sm font-bold">Ventas</h2>
                <p class="text-xs text-tenue">Ventas nuevas de cada día, contadas el día y la hora del primer pago.</p>
              </header>

              <form id="filtro-ventas" class="mt-3 flex flex-wrap items-end gap-x-6 gap-y-3 rounded-xl bg-lila p-3">
                <fieldset class="flex flex-wrap items-end gap-2">
                  <legend class="mb-1 text-xs font-bold text-tinta">Días</legend>
                  <label class="text-xs text-tinta-2">
                    <span class="sr-only">Desde el día</span>
                    <select name="diaDesde" class="filtro" />
                  </label>
                  <span class="pb-1.5 text-xs text-tenue">a</span>
                  <label class="text-xs text-tinta-2">
                    <span class="sr-only">Hasta el día</span>
                    <select name="diaHasta" class="filtro" />
                  </label>
                </fieldset>
                <fieldset class="flex flex-wrap items-end gap-2">
                  <legend class="mb-1 text-xs font-bold text-tinta">Horas (Colombia)</legend>
                  <label class="text-xs text-tinta-2">
                    <span class="sr-only">Desde la hora</span>
                    <select name="horaDesde" class="filtro" />
                  </label>
                  <span class="pb-1.5 text-xs text-tenue">a</span>
                  <label class="text-xs text-tinta-2">
                    <span class="sr-only">Hasta la hora</span>
                    <select name="horaHasta" class="filtro" />
                  </label>
                </fieldset>
                <button
                  type="reset"
                  class="foco rounded-lg border border-lila-borde bg-white px-3 py-1.5 text-xs font-semibold text-morado hover:bg-white/70"
                >
                  Quitar filtros
                </button>
              </form>

              <p class="mt-3 text-sm font-semibold text-tinta-2" data-sub="ventas-total" />
              <p class="text-xs text-tenue" data-sub="ventas-nota" />
              <div class="relative mt-3 h-80">
                <canvas id="g-ventas" role="img" aria-label="Ventas nuevas por día alineadas a la Clase 1" />
              </div>
            </article>
          </section>

          {/* Asistencia en vivo de cada clase y los copys enviados ese día */}
          <section id="panel-asistencia" class="panel space-y-4" aria-labelledby="t-asistencia">
            <header>
              <h2 id="t-asistencia" class="text-sm font-bold">Asistencia y mensajería</h2>
              <p class="text-xs text-tenue">
                Personas conectadas en cada clase (YouTube + Zoom) y los copys enviados, marcados con líneas punteadas.
              </p>
            </header>
            <div id="clases" class="grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-6" role="group" aria-label="Clase" />
            <div class="flex flex-wrap items-center justify-between gap-3">
              <div id="picos" class="flex flex-wrap gap-x-8 gap-y-2" />
              <div class="flex flex-wrap items-center gap-2">
                <div id="ver-lanzamientos" class="flex gap-2" role="group" aria-label="Lanzamientos visibles" />
                <div class="segmento" role="group" aria-label="Plataforma" id="plataforma">
                  <button type="button" data-valor="total">Total</button>
                  <button type="button" data-valor="youtube">YouTube</button>
                  <button type="button" data-valor="zoom">Zoom</button>
                </div>
              </div>
            </div>
            <div class="relative h-80">
              <canvas id="g-asistencia" role="img" aria-label="Asistencia durante la clase" />
            </div>
            <div>
              <h3 class="text-xs font-bold uppercase tracking-wide text-tenue">Línea de tiempo</h3>
              <div id="linea-tiempo" class="mt-2 grid grid-cols-1 gap-4 lg:grid-cols-2" />
            </div>
          </section>

          <footer class="space-y-1 pb-4 text-xs text-tenue">
            <p>
              <strong class="text-tinta-2">Fuente:</strong> módulo Lanzamientos de inventario (registros e inversión) y
              módulo Cartera (ventas). La asistencia y los copys salen de Asistencia y Parrilla de cada lanzamiento. Esta
              página solo lee la base de datos.
            </p>
            <p>
              Los dos lanzamientos se alinean por la Clase 1 para compararlos en el mismo punto de la captación. Los
              días sin registro se unen con una línea recta.
            </p>
          </footer>

          <script is:inline type="application/json" id="datos-comparativa" set:html={json} />
        </>
      )
    }
  </main>
</Layout>

<script>
  import '../scripts/comparativa.ts';
</script>
